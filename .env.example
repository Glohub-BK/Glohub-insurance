# ─────────────────────────────────────────────────────────────────────────
#  이 파일을 .env.local 로 복사해서 쓰세요.
#
#  ⚠ 위치가 중요합니다. .env.local 은 package.json 과 같은 폴더(프로젝트 루트)에
#    있어야 합니다. 상위 폴더에 두면 아무것도 읽히지 않습니다.
#
#    O  insurance/.env.local
#    X  insurance/../.env.local
# ─────────────────────────────────────────────────────────────────────────

# ── 데이터베이스 ──────────────────────────────────────────────────────────
# 로컬 개발 (docker-compose up -d)
DATABASE_URL=postgresql://insurance:insurance@localhost:5433/insurance

# Supabase 로 옮길 때는 위를 주석 처리하고 아래를 쓰세요.
# 대시보드 → Project Settings → Database → Connection string
#
#   내 PC 에서 스크립트를 돌릴 때  → Session pooler  (포트 5432)
#   Vercel 등 서버리스에 올릴 때   → Transaction pooler (포트 6543)
#
# ⚠ 서버리스에서 5432 를 쓰면 인스턴스마다 직접 연결이 쌓여 금세 상한을 넘깁니다.
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres

# ── CODEF ────────────────────────────────────────────────────────────────
# 절대 커밋하지 마세요. .gitignore 가 .env* 를 막고 있습니다.
#
# 키는 https://codef.io/#/account/keys 에서 확인합니다.
# ⚠ 클라이언트 ID·시크릿은 **환경마다 다릅니다**(샌드박스 / 데모 / 정식 각각 발급).
#   공개키(RSA)만 계정당 하나로 공통입니다.

# sandbox = 고정 응답(무료·무제한) / demo = 실데이터(1개월·하루 100건) / api = 정식(과금)
# demo 는 CODEF 콘솔의 "데모버전"(development.codef.io)입니다. 도메인 이름을 따라
# CODEF_ENV=development 라고 적어도 같은 값으로 읽습니다.
# ⚠ 필수입니다. 비워 두면 앱이 조회를 거부합니다 — 예전처럼 조용히 샌드박스로 붙지 않습니다.
#   샌드박스는 휴대폰 인증 없이 통과하고 가짜 계약을 돌려주므로, 설정 누락과 구분되어야 합니다.
CODEF_ENV=demo

# 환경별 키. 앱은 CODEF_ENV 에 맞는 것을 골라 씁니다.
CODEF_SANDBOX_CLIENT_ID=
CODEF_SANDBOX_CLIENT_SECRET=
CODEF_DEMO_CLIENT_ID=
CODEF_DEMO_CLIENT_SECRET=
# 정식 전환 시에만 채웁니다.
# CODEF_API_CLIENT_ID=
# CODEF_API_CLIENT_SECRET=

# 위 환경별 값이 비어 있을 때만 쓰이는 공용 값입니다.
# 한 환경만 쓰는 동안에는 이 두 줄로도 충분하지만, 환경을 오가려면 위쪽을 채우세요.
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=

# 공개키는 환경과 무관하게 하나. 줄바꿈 없이 한 줄로 넣습니다.
CODEF_PUBLIC_KEY=

# ── 실데이터 안전장치 ─────────────────────────────────────────────────────
# demo·api 환경은 이 스위치가 true 여야 조회가 나갑니다. sandbox 에서는 무시됩니다.
# 실수로 한 번 눌러 하루치를 날리는 사고를 막는 장치입니다.
CODEF_ALLOW_LIVE=false

# 하루 조회 한도. 생략하면 100. sync_run 기록으로 세므로 앱을 껐다 켜도 이어집니다.
CODEF_DAILY_LIMIT=100

# ── AI 약관 분석 (Gemini) ────────────────────────────────────────────────
# 규칙이 못 잡은 사고 문장을 약관 조항과 대조하는 2차 경로에 씁니다.
# 키 발급: https://aistudio.google.com/apikey  (Google AI Studio → Create API key)
# 키가 비어 있으면 AI 분석 버튼 자체가 화면에 나오지 않습니다 — 앱은 정상 동작합니다.
GEMINI_API_KEY=

# 쓸 모델. 비우면 gemini-3.5-flash 를 씁니다. 더 새 모델로 바꿀 때만 채우세요.
# (2.5-flash 는 신규 발급 키에서 404 가 보고되어 기본값에서 내렸습니다.)
# GEMINI_MODEL=gemini-3.5-flash
